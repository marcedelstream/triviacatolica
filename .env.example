# Credenciales públicas de Supabase (copiar este archivo a .env)
# Si quedan vacías, la app funciona en modo local con datos precargados.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Claves públicas opcionales de RevenueCat (cuando actives suscripciones reales)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
